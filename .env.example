# PostgreSQL connection string (shared by apps/web and apps/ws-server via packages/db)
DATABASE_URL=postgres://user:password@localhost:5432/degommix

# Better Auth (apps/web)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Socket.IO server URL exposed to the browser (apps/web)
NEXT_PUBLIC_WS_URL=http://localhost:4001

# Allowed CORS origin for the ws-server (apps/ws-server)
WEB_ORIGIN=http://localhost:3000
