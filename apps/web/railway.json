{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@degommix/web --env-mode=loose",
    "watchPatterns": [
      "apps/web/**",
      "packages/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @degommix/web start",
    "preDeployCommand": ["pnpm --filter @degommix/db db:migrate"],
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
